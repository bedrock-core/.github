{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "enabledManagers": ["npm", "github-actions", "custom.jsonata"],
  "rangeStrategy": "update-lockfile",
  "automerge": false,
  "prConcurrentLimit": 5,
  "prHourlyLimit": 2,
  "lockFileMaintenance": { "enabled": false },
  "packageRules": [
    {
      "description": "Review external non-major updates together.",
      "matchManagers": ["npm", "github-actions"],
      "matchUpdateTypes": ["minor", "patch", "digest", "pin"],
      "matchPackageNames": ["!@minecraft/*", "!@bedrock-core/*"],
      "groupName": "external dependencies (non-major)"
    },
    {
      "description": "Keep published consumer compatibility ranges under manual control.",
      "matchManagers": ["npm"],
      "matchDepTypes": ["peerDependencies", "engines"],
      "enabled": false
    },
    {
      "description": "Internal Core dependencies follow the coordinated release process.",
      "matchPackageNames": ["@bedrock-core/*", "bedrock-core/*"],
      "enabled": false
    },
    {
      "description": "Prepare the source branch for the repository's Minecraft update workflow.",
      "matchManagers": ["custom.jsonata"],
      "groupName": "Minecraft sources",
      "groupSlug": "minecraft-sources",
      "separateMajorMinor": false,
      "separateMultipleMajor": false,
      "prCreation": "approval",
      "rebaseWhen": "behind-base-branch",
      "prPriority": 10
    },
    {
      "matchDatasources": [
        "custom.minecraft-npm",
        "custom.minecraft-releases"
      ],
      "versioning": "regex:^(?<patch>\\d+)$"
    },
    {
      "matchManagers": ["custom.jsonata"],
      "matchDatasources": ["git-refs"],
      "pinDigests": true
    },
    {
      "description": "Include stable Minecraft dependencies that are outside the game matrix.",
      "matchManagers": ["npm"],
      "matchPackageNames": ["@minecraft/*"],
      "allowedVersions": "/^\\d+\\.\\d+\\.\\d+$/",
      "ignoreUnstable": true,
      "groupName": "Minecraft sources",
      "groupSlug": "minecraft-sources",
      "separateMajorMinor": false,
      "separateMultipleMajor": false,
      "prCreation": "approval",
      "rebaseWhen": "behind-base-branch",
      "prPriority": 10
    },
    {
      "description": "Use the game matrix to select these SDK versions.",
      "matchManagers": ["npm"],
      "matchPackageNames": [
        "@minecraft/server",
        "@minecraft/server-ui",
        "@minecraft/server-gametest",
        "@minecraft/vanilla-data"
      ],
      "enabled": false
    }
  ],
  "customManagers": [
    {
      "customType": "jsonata",
      "fileFormat": "json",
      "managerFilePatterns": ["/^sources\\.json$/"],
      "matchStrings": [
        "bds.{\"depName\": \"Bedrock Dedicated Server builds\", \"packageName\": repository, \"datasource\": \"git-refs\", \"currentValue\": branch, \"currentDigest\": commit}",
        "$each(npm, function($value, $name) { {\"depName\": $name, \"datasource\": \"custom.minecraft-npm\", \"currentValue\": $value} })",
        "$each(releases, function($value, $name) { {\"depName\": $name, \"datasource\": \"custom.minecraft-releases\", \"currentValue\": $value} })"
      ]
    }
  ],
  "customDatasources": {
    "minecraft-npm": {
      "defaultRegistryUrlTemplate": "https://registry.npmjs.org/{{{packageName}}}",
      "format": "json",
      "transformTemplates": [
        "{\"releases\": [{\"version\": $string($toMillis(time.modified)), \"releaseTimestamp\": time.modified}]}"
      ]
    },
    "minecraft-releases": {
      "defaultRegistryUrlTemplate": "https://api.github.com/repos/{{{packageName}}}/releases?per_page=100",
      "format": "json",
      "transformTemplates": [
        "($published := $[draft = false]; $dates := [$published.published_at, $published.assets[state = \"uploaded\"].updated_at]; $latest := $max($map($dates, function($stamp) {$toMillis($stamp)})); {\"releases\": [{\"version\": $string($latest), \"releaseTimestamp\": $fromMillis($latest)}]})"
      ]
    }
  }
}
